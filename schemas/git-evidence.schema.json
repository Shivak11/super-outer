{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Shivak11/Super-outer/schemas/git-evidence.schema.json",
  "title": "Super-outer Git topology evidence",
  "type": "object",
  "required": [
    "schema_version",
    "repository_root_hash",
    "branch",
    "base_ref",
    "merge_base",
    "head",
    "ahead",
    "behind",
    "changed_files",
    "deleted_files",
    "commits",
    "dirty",
    "worktree_hash",
    "ci_head",
    "ci_evidence",
    "exact_head",
    "release_head",
    "release_exact_head"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "repository_root_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "branch": {
      "type": "string"
    },
    "base_ref": {
      "type": "string"
    },
    "merge_base": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "head": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "ahead": {
      "type": "integer",
      "minimum": 0
    },
    "behind": {
      "type": "integer",
      "minimum": 0
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deleted_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{40}$"
      }
    },
    "dirty": {
      "type": "boolean"
    },
    "worktree_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ci_head": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{40}$"
    },
    "ci_evidence": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "provider",
        "repository",
        "workflow",
        "run_id",
        "status",
        "conclusion",
        "head_sha",
        "verified_by",
        "valid"
      ],
      "properties": {
        "provider": { "type": "string" },
        "repository": { "type": "string" },
        "workflow": { "type": "string" },
        "run_id": { "type": "string" },
        "status": { "type": "string" },
        "conclusion": { "type": "string" },
        "head_sha": { "type": "string" },
        "verified_by": { "type": "string" },
        "valid": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "exact_head": {
      "type": "boolean"
    },
    "release_head": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{40}$"
    },
    "release_exact_head": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
